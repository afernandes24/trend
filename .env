# ===================== AURA TREND — konfiguracja =====================
# Skopiuj ten plik do .env i uzupełnij. Po zmianie uruchom aplikację ponownie.

# --- Aplikacja ---
APP_HOST=127.0.0.1
APP_PORT=8000
# Logowanie do aplikacji (WYMAGANE na serwerze w internecie)
APP_USERNAME=admin
APP_PASSWORD=
# DATABASE_PATH=data/aura_trend.db

# --- Dane rynkowe ---
# yahoo = darmowe dane (futures / indeksy kasowe jako proxy CFD XTB)
# csv   = tylko pliki z data/import/<SYMBOL>_<TF>.csv
# xtb   = adapter do podłączenia (backend/app/market_data/xtb.py)
MARKET_DATA_PROVIDER=yahoo
# co ile sekund sprawdzać nowe świece 5M (alert tuż po zamknięciu świecy 15M)
SCAN_INTERVAL_SECONDS=60
# co ile sekund odświeżać świece 1H
H1_REFRESH_SECONDS=300
SCANNER_ENABLED=true

# --- Telegram (zalecany: alert na telefon w 1–2 s, za darmo) ---
# token od @BotFather; chat id znajdziesz w aplikacji: Alerty → „Znajdź chat ID"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- E-mail (SMTP) ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, hasło = "hasło aplikacji" (nie zwykłe hasło konta)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=
# kilku odbiorców po przecinku
ALERT_EMAIL_TO=

# --- SMS ---
# none | twilio | smsapi
SMS_PROVIDER=none
# numery w formacie międzynarodowym, po przecinku, np. +48600100200
ALERT_SMS_TO=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# SMSAPI.pl (token OAuth z panelu SMSAPI)
SMSAPI_TOKEN=
SMSAPI_SENDER=

# --- XTB (adapter — tylko odczyt cen, aplikacja nie składa zleceń) ---
XTB_USER=
XTB_PASSWORD=
XTB_MODE=demo
